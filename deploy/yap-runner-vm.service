# Supervises the Kata VM that serves run-yap.nullptr.free.
#
# Install it without copying anything (it stays version-controlled here):
#   systemctl --user link ~/web-yap-runner/deploy/yap-runner-vm.service
#   systemctl --user enable --now yap-runner-vm.service
#
# Deliberately NOT named yap-runner.service: an older hand-written unit by
# that name still sits in ~/.config/systemd/user/, disabled, with an
# ExecStart that never matched how the runner actually ran (plain `node
# src/server.js`, no VM). Linking over a regular file of the same name would
# fail, so this takes a new name and the stale one can be deleted whenever.
[Unit]
Description=web-yap-runner in a Kata VM (run-yap.nullptr.free)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/web-yap-runner
ExecStart=%h/web-yap-runner/deploy/run-container.sh
Restart=always
RestartSec=5
# nerdctl forwards SIGTERM to the guest and --rm cleans the VM up, but a Kata
# VM takes longer to go down than the default 90s grace in the worst case.
TimeoutStopSec=120

[Install]
WantedBy=default.target
